# Copy to .env and fill in real values. Never commit .env itself.

# router.py — all optional, defaults shown match the project's original
# hardcoded values.
# ROUTES_CONFIG_PATH=app/config/routes.yaml
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# SIMILARITY_THRESHOLD=0.55
# AMBIGUITY_MARGIN=0.05
# MAX_QUERY_LEN=500

# gemini_client.py
GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-3.8-flash
# MAX_RPM=10
# MAX_RETRIES=2
# TIMEOUT_S=10   # Google's API rejects anything below 10

# api.py — required for POST /query to accept requests (no default: every
# request is rejected with 401 until this is set). Send it back as the
# X-API-Key header.
API_KEY=
# RATE_LIMIT=30/minute

# LOG_LEVEL=INFO
